{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Блокнот",
  "mainBinaryName": "bloknot",
  "version": "1.0.0",
  "identifier": "pro.chasovskikh.bloknot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Блокнот",
    "shortDescription": "Блокнот",
    "longDescription": "Приложение для Windows к вашему Блокноту на сервере: отдельное окно, значок в трее, уведомления о новых версиях.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installMode": "currentUser"
      }
    }
  }
}
