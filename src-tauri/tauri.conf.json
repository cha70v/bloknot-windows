{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloknot",
  "mainBinaryName": "Bloknot",
  "version": "1.0.2",
  "identifier": "pro.chasovskikh.bloknot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bloknot",
    "shortDescription": "Bloknot",
    "longDescription": "Bloknot for Windows and macOS: a desktop window for your self-hosted Bloknot notebook.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "Russian"
        ],
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "Bloknot",
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
